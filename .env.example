# Server & App Environment
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Database (PostgreSQL)
# For local Docker: postgresql://voice2flow:voice2flow_secret@localhost:5432/voice2flow?schema=public
DATABASE_URL=postgresql://voice2flow:voice2flow_secret@localhost:5432/voice2flow?schema=public

# Authentication & JWT
JWT_ACCESS_SECRET=super_secret_jwt_access_key_min_32_chars_long_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_chars_long_67890
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# AI Configuration (Provider-agnostic)
# Options for AI_PROVIDER: gemini | openai | anthropic | rules
AI_PROVIDER=rules
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=8000
AI_DAILY_LIMIT_PER_USER=100
AI_RICH_RESPONSES=false

# AI API Keys (Optional if AI_PROVIDER=rules)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Background Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000

# Email / SMTP Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Voice2Flow <no-reply@voice2flow.local>
